# Xcode / Swift
Shepherd.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
.build/
# `xcodebuild` without `-derivedDataPath` writes here, in the repository root and beside every
# package it builds.
build/
.swiftpm/
Package.resolved

# Generated by `xcodegen generate` from the `info:` block in project.yml, like the .xcodeproj.
Shepherd/Support/Info.plist

# Release artefacts (Scripts/release.sh writes here; the DMG/ZIP/appcast belong on a
# GitHub release, never in git). Root-anchored, because Shepherd/Resources/DiffViewer/dist IS
# committed — see below.
/dist/

# Local task-runner overrides: `mise.local.toml` carries the maintainer's signing identity and
# team id, which are per-machine values rather than project configuration (`mise.toml` is the
# committed half and reads them from the environment).
mise.local.toml

# Signing material. A belt-and-braces net, not a place to keep these: the Sparkle private key
# belongs in the login Keychain and a password manager, the App Store Connect key outside the
# working tree entirely (docs/RELEASING.md).
sparkle-private-key*.txt
*.p8

# Node
node_modules/
web/diff-viewer/.cache/

# NOTE: Shepherd/Resources/DiffViewer/dist IS committed on purpose (ADR 0003)
# so that app builders don't need Node.

# OS / editors
.DS_Store
*.swp
.idea/
.vscode/

# The product page (site/): Next.js build output. node_modules/ is covered above.
site/.next/
site/out/
site/next-env.d.ts
site/*.tsbuildinfo
