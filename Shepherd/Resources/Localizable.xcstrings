            "value": "Dateien"
          }
        }
      }
    },
    "Files are ordered by review priority, riskiest first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien sind nach Review-Priorität sortiert, die riskanteste zuerst."
          }
