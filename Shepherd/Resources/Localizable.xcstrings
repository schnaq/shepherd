            "value": "%@ → %@"
          }
        }
      }
    },
    "%@#%lld got new commits after you wrote your review, so your inline comments would land on the wrong lines. Your draft is kept — open the pull request again to check it against the new commit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@#%lld hat neue Commits bekommen, nachdem du dein Review geschrieben hast — deine Inline-Kommentare würden auf den falschen Zeilen landen. Dein Draft bleibt erhalten; öffne den Pull Request erneut und prüfe ihn gegen den neuen Commit."
          }
        }
      }
    },
    "%@. %@": {
