    "Install it with `npm install -g @anthropic-ai/claude-code`, then point Shepherd at the binary.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere es mit `npm install -g @anthropic-ai/claude-code` und zeige Shepherd dann auf die Binary."
          }
