            "value": "Aufgabe für den Agenten"
          }
        }
      }
    },
    "Task from the reviewer:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgabe vom Reviewer:"
          }
        }
      }
    },
    "Test connection": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung testen"
          }
        }
