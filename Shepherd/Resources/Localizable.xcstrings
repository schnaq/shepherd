    "Nothing synced yet. Press ⌘R to run a sync now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts synchronisiert. Drücke ⌘R, um jetzt zu synchronisieren."
          }
