    },
    "This step recorded no content.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Schritt wurde kein Inhalt aufgezeichnet."
          }
        }
      }
    },
    "This tier cannot draft a brief for a coding agent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Stufe kann keine Aufgabenbeschreibung für einen Coding-Agenten entwerfen."
