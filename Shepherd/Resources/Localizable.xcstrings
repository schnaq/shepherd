    "Test event": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Testereignis"
          }
        }
      }
    },
    "That is not a valid URL.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist keine gültige URL."
          }
        }
      }
    },
    "That is not a valid https endpoint URL.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist keine gültige https-Endpunkt-URL."
          }
        }
      }
    },
    "That pull request is not in Shepherd's inbox any more.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Pull Request ist nicht mehr in der Inbox von Shepherd."
          }
        }
      }
    },
    "The GitHub token changed for another account — sign out and sign in again to use it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das GitHub-Token hat sich für einen anderen Account geändert — melde dich ab und wieder an, um es zu verwenden."
          }
        }
      }
    },
    "The JSON files in the folder are removed. Nothing else is touched, and no copy of them exists anywhere else.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die JSON-Dateien im Ordner werden entfernt. Sonst wird nichts angetastet, und es gibt nirgends eine Kopie davon."
          }
        }
      }
    },
    "The Keychain token is deleted and the local database is emptied. Pending reviews that have not been sent are lost.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Token im Schlüsselbund wird gelöscht und die lokale Datenbank geleert. Offene Reviews, die noch nicht gesendet wurden, sind verloren."
          }
        }
      }
    },
    "The agent CLI could not be found. Set its path in Settings → Delegation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Agent-CLI wurde nicht gefunden. Setze ihren Pfad in Einstellungen → Delegation."
          }
        }
      }
    },
    "The agent changed nothing that is tracked by git.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent hat nichts geändert, was git verfolgt."
          }
        }
      }
    },
    "The agent edits files in the worktree without asking. Nothing is pushed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent bearbeitet Dateien im Worktree, ohne zu fragen. Es wird nichts gepusht."
          }
        }
      }
    },
    "The agent finished": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent ist fertig"
          }
        }
      }
    },
    "The agent finished.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent ist fertig."
          }
        }
      }
    },
    "The agent only writes a plan. No file is changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent schreibt nur einen Plan. Keine Datei wird geändert."
          }
        }
      }
    },
    "The agent stopped with an error": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent hat mit einem Fehler aufgehört"
          }
        }
      }
    },
    "The agent stopped with an error.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent hat mit einem Fehler aufgehört."
          }
        }
      }
    },
    "The bucket could not be reached: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bucket war nicht erreichbar: %@"
          }
        }
      }
    },
    "The bucket name must not be empty or contain a slash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bucket-Name darf nicht leer sein und keinen Schrägstrich enthalten."
          }
        }
      }
    },
    "The command template ends with a stray backslash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Befehlsvorlage endet mit einem einzelnen Backslash."
          }
        }
      }
    },
    "The command template has an unterminated %@ quote.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Befehlsvorlage ist ein %@-Anführungszeichen nicht geschlossen."
          }
        }
      }
    },
    "The custom command template is empty.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die eigene Befehlsvorlage ist leer."
          }
        }
      }
    },
    "The custom command template must contain {prompt} so Shepherd knows where the prompt goes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die eigene Befehlsvorlage muss {prompt} enthalten, damit Shepherd weiß, wohin der Prompt gehört."
          }
        }
      }
    },
    "The diff viewer follows the same setting: the theme is pushed into Monaco over the bridge.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Diff-Ansicht folgt derselben Einstellung: Das Thema wird über die Bridge in Monaco geschoben."
          }
        }
      }
    },
    "The endpoint did not list any models. Type the model name instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Endpunkt hat keine Modelle aufgelistet. Gib den Modellnamen stattdessen ein."
          }
        }
      }
    },
    "The event could not be encoded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ereignis konnte nicht kodiert werden."
          }
        }
      }
    },
    "The head commit has no checks at all, so there is nothing green to rely on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Head-Commit hat überhaupt keine Checks, es gibt also kein Grün, auf das man sich stützen könnte."
          }
        }
      }
    },
    "The key is stored in your Keychain, next to the GitHub token, and is sent only to the endpoint above.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel liegt in deinem Schlüsselbund, neben dem GitHub-Token, und wird nur an den Endpunkt oben gesendet."
          }
        }
      }
    },
    "The log did not fit the on-device model, and no cloud provider is configured.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Log passt nicht in das Modell auf diesem Gerät, und es ist kein Cloud-Anbieter konfiguriert."
          }
        }
      }
    },
    "The model asked to read more than Shepherd allows for one diagnosis.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell wollte mehr lesen, als Shepherd für eine Diagnose erlaubt."
          }
        }
      }
    },
    "The model endpoint returned %lld: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Modell-Endpunkt hat %lld geantwortet: %@"
          }
        }
      }
    },
    "The model gave no reason for this one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell hat hierfür keinen Grund genannt."
          }
        }
      }
    },
    "The model returned an empty draft.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell hat einen leeren Draft zurückgegeben."
          }
        }
      }
    },
    "The model returned an empty explanation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell hat eine leere Erklärung zurückgegeben."
          }
        }
      }
    },
    "The model returned something Shepherd could not read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell hat etwas zurückgegeben, das Shepherd nicht lesen konnte."
          }
        }
      }
    },
    "The object in the bucket is not a Shepherd settings envelope.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Objekt im Bucket ist kein Shepherd-Einstellungs-Envelope."
          }
        }
      }
    },
    "The on-device model had nothing to say about this one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das On-Device-Modell hatte dazu nichts zu sagen."
          }
        }
      }
    },
    "The on-device model is still downloading. Try again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das On-Device-Modell wird noch geladen. Versuch es später erneut."
          }
        }
      }
    },
    "The on-device model is unavailable right now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das On-Device-Modell ist im Moment nicht verfügbar."
          }
        }
      }
    },
    "The original above is always shown, translated or not.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Original oben wird immer gezeigt, übersetzt oder nicht."
          }
        }
      }
    },
    "The passphrase could not be turned into a key (status %d).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Passphrase konnte nicht in einen Schlüssel umgewandelt werden (Status %d)."
          }
        }
      }
    },
    "The passphrase is never uploaded and never written to preferences. It is what turns into the encryption key, so if you lose it the object in the bucket is unreadable — there is no recovery and no reset. Use the same passphrase on every Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Passphrase wird nie hochgeladen und nie in die Einstellungen geschrieben. Sie ist es, was zum Schlüssel wird — verlierst du sie, ist das Objekt im Bucket unlesbar. Es gibt keine Wiederherstellung und kein Zurücksetzen. Nutze auf jedem Mac dieselbe Passphrase."
          }
        }
      }
    },
    "The payload says what happened — repository, number, title, author, provenance, verdict — and nothing more. No review text, no comment bodies, no diffs and no agent output leave your Mac. Events fire only after the action really succeeded, and only while the toggle above is on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nutzlast sagt, was passiert ist — Repository, Nummer, Titel, Autor, Herkunft, Bewertung — und nichts weiter. Kein Review-Text, keine Kommentartexte, keine Diffs und keine Agentenausgabe verlassen deinen Mac. Ereignisse feuern erst, wenn die Aktion wirklich geklappt hat, und nur solange der Schalter oben an ist."
          }
        }
      }
    },
    "The pull request got new commits. Re-review before submitting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pull Request hat neue Commits bekommen. Reviewe erneut, bevor du abschickst."
          }
        }
      }
    },
    "The pull request is still loading.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pull Request wird noch geladen."
          }
        }
      }
    },
    "The queue was frozen when the session started, so pull requests arriving now wait in the inbox. %lld left.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Warteschlange wurde beim Start der Sitzung eingefroren; Pull Requests, die jetzt hereinkommen, warten in der Inbox. %lld übrig."
          }
        }
      }
    },
    "The review is queued in the local outbox and sent by the sync engine, so it survives a crash or a lost connection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Review wird in der lokalen Outbox eingereiht und von der Sync-Engine gesendet — so übersteht es einen Absturz oder eine abgebrochene Verbindung."
          }
        }
      }
    },
    "The same method the merge sheet and bulk triage use — whichever you merged with last. Changing it here changes it there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselbe Methode, die auch das Merge-Fenster und die Sammel-Triage nutzen — die, mit der du zuletzt gemergt hast. Änderst du sie hier, ändert sie sich auch dort."
          }
        }
      }
    },
    "The settings decrypted, but their contents could not be read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen wurden entschlüsselt, aber ihr Inhalt war nicht lesbar."
          }
        }
      }
    },
    "The storage service answered %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicherdienst hat %lld geantwortet."
          }
        }
      }
    },
    "The storage service answered %lld: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicherdienst hat %lld geantwortet: %@"
          }
        }
      }
    },
    "The stored settings declare an implausible key-derivation cost (%lld iterations) and were not decrypted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherten Einstellungen nennen einen unplausiblen Aufwand für die Schlüsselableitung (%lld Iterationen) und wurden nicht entschlüsselt."
          }
        }
      }
    },
    "The stored settings use an algorithm this build does not know: %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherten Einstellungen nutzen einen Algorithmus, den dieser Build nicht kennt: %@."
          }
        }
      }
    },
    "The stored settings were written by a newer Shepherd (envelope version %lld). Update Shepherd on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherten Einstellungen wurden von einem neueren Shepherd geschrieben (Envelope-Version %lld). Aktualisiere Shepherd auf diesem Mac."
          }
        }
      }
    },
    "The template is split like a shell would, but no shell ever runs it: {prompt} always becomes exactly one argument, so a prompt cannot turn into a second command. {worktree} becomes the worktree path.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorlage wird zerlegt, wie eine Shell es täte — aber keine Shell führt sie je aus: {prompt} wird immer genau ein Argument, ein Prompt kann also nie zu einem zweiten Befehl werden. {worktree} wird der Pfad des Worktrees."
          }
        }
      }
    },
    "The updater could not start: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Updater konnte nicht starten: %@"
          }
        }
      }
    },
    "The webhook accepted the test event.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Webhook hat das Testereignis angenommen."
          }
        }
      }
    },
    "The webhook answered %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Webhook hat %lld geantwortet."
          }
        }
      }
    },
    "The webhook could not be reached: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Webhook war nicht erreichbar: %@"
          }
        }
      }
    },
    "There is no confirmation click. With this on, Shepherd queues the merge as soon as a sweep sees a pull request that satisfies every rule below — the same merge you would have queued from the merge sheet, sent through the same outbox. That includes pull requests that are already waiting, so switching this on can merge several of them on the next sweep.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keinen Bestätigungsklick. Ist das eingeschaltet, reiht Shepherd den Merge ein, sobald ein Sweep einen Pull Request sieht, der jede Regel unten erfüllt — denselben Merge, den du aus dem Merge-Fenster eingereiht hättest, gesendet über dieselbe Outbox. Das gilt auch für Pull Requests, die schon warten: Einschalten kann also beim nächsten Sweep mehrere davon mergen."
          }
        }
      }
    },
    "These only need read and write access to this one object. The keys never leave your Keychain and are used to sign requests, not sent as data.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie brauchen nur Lese- und Schreibzugriff auf dieses eine Objekt. Die Schlüssel verlassen deinen Schlüsselbund nie und werden zum Signieren von Anfragen genutzt, nicht als Daten gesendet."
          }
        }
      }
    },
    "These pull requests got new commits after the review was queued, so nothing was sent. Open each one and check your draft against the new commit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Pull Requests haben neue Commits bekommen, nachdem das Review eingereiht wurde — gesendet wurde deshalb nichts. Öffne jeden davon und prüfe deinen Draft gegen den neuen Commit."
          }
        }
      }
    },
    "These settings were written by %@ at %@ and carry %lld secrets. Applying them overwrites the settings on this Mac, including the keys in your Keychain. Local data, drafts and the outbox are untouched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einstellungen wurden von %@ um %@ geschrieben und enthalten %lld Secrets. Sie zu übernehmen überschreibt die Einstellungen auf diesem Mac, inklusive der Schlüssel in deinem Schlüsselbund. Lokale Daten, Drafts und die Outbox bleiben unberührt."
          }
        }
      }
    },
    "These settings were written by a newer Shepherd (document version %lld). Update Shepherd on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einstellungen wurden von einem neueren Shepherd geschrieben (Dokumentversion %lld). Aktualisiere Shepherd auf diesem Mac."
          }
        }
      }
    },
    "This Mac does not support Apple Intelligence.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac unterstützt Apple Intelligence nicht."
          }
        }
      }
    },
    "This Mac has no on-device sentence-embedding model, so search matches words rather than meaning.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac hat kein On-Device-Modell für Satz-Embeddings, deshalb trifft die Suche Wörter statt Bedeutung."
          }
        }
      }
    },
    "This build has no GitHub App client ID (Shepherd/Support/AppConfig.swift is empty), so device flow is off. Use a personal access token below.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build hat keine Client-ID einer GitHub App (Shepherd/Support/AppConfig.swift ist leer), deshalb ist der Device-Flow aus. Nimm unten ein Personal Access Token."
          }
        }
      }
    },
    "This build has no GitHub App client ID. Use a personal access token.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build hat keine Client-ID einer GitHub App. Nimm ein Personal Access Token."
          }
        }
      }
    },
    "This build has no update feed, so it will never offer an update. Releases from github.com/schnaq/review do.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build hat keinen Update-Feed und wird deshalb nie ein Update anbieten. Releases von github.com/schnaq/review tun das."
          }
        }
      }
    },
    "This build has no update-signing key yet, so updates are switched off rather than unverified. Releases from github.com/schnaq/review are signed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build hat noch keinen Update-Signierschlüssel, deshalb sind Updates aus statt unverifiziert. Releases von github.com/schnaq/review sind signiert."
          }
        }
      }
    },
    "This content is larger than the on-device model's context window. A cloud provider has room for it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Inhalt ist größer als das Kontextfenster des On-Device-Modells. Ein Cloud-Provider hat dafür Platz."
          }
        }
      }
    },
    "This endpoint cannot call tools, so it cannot look up why CI is red.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Endpunkt kann keine Tools aufrufen und daher nicht nachsehen, warum die CI rot ist."
          }
        }
      }
    },
    "This gateway reads both fields: it picks a deployment in one of those countries, and — with zero retention asked for — one that stores neither your prompt nor the answer. It refuses the request rather than serving it from somewhere else, and the answer says which operator ran it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gateway liest beide Felder: Es wählt ein Deployment in einem dieser Länder und — wenn keine Speicherung verlangt ist — eines, das weder deine Eingabe noch die Antwort speichert. Es lehnt die Anfrage ab, statt sie von anderswo zu beantworten, und die Antwort nennt den Betreiber, der das Modell ausgeführt hat."
          }
        }
      }
    },
    "This provider cannot explain a selection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Anbieter kann eine Auswahl nicht erklären."
          }
        }
      }
    },
    "This pull request has no changed files.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Pull Request hat keine geänderten Dateien."
          }
        }
      }
    },
    "This pull request is no longer in your inbox": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Pull Request ist nicht mehr in deiner Inbox"
          }
        }
      }
    },
    "This pull request needs ~%lld tokens, over the %lld token budget.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Pull Request braucht ~%lld Tokens und liegt damit über dem Budget von %lld Tokens."
          }
        }
      }
    },
    "This replaces the settings on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ersetzt die Einstellungen auf diesem Mac."
