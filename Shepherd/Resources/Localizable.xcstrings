{
  "sourceLanguage": "en",
  "strings": {
    " · %lld skipped": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " · %lld übersprungen"
          }
        }
      }
    },
    "\"Turns\" is meant literally: Shepherd has to have seen the change happen. A pull request that was already red when Shepherd first saw it never starts anything, and each pull request starts at most one run per commit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Turns“ ist wörtlich gemeint: Shepherd muss die Änderung selbst gesehen haben. Ein Pull Request, der schon rot war, als Shepherd ihn zum ersten Mal sah, startet nie etwas, und jeder Pull Request startet höchstens einen Lauf pro Commit."
          }
        }
      }
    },
    "#%lld is a pull request rather than an issue, so it has no acceptance criteria.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "#%lld ist ein Pull Request und kein Issue, hat also keine Akzeptanzkriterien."
          }
        }
      }
    },
    "$%@ max": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "max. $%@"
          }
        }
      }
    },
    "%@ #%lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ #%lld"
          }
        }
      }
    },
    "%@ %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@"
          }
        }
      }
    },
    "%@ has conflicts with its base branch. Resolve them first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat Konflikte mit dem Basis-Branch. Löse sie zuerst."
          }
        }
      }
    },
    "%@ is a recognised agent": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist ein erkannter Agent"
          }
        }
      }
    },
    "%@ is not a GitHub Actions job": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist kein GitHub-Actions-Job"
          }
        }
      }
    },
    "%@ is not in Shepherd's inbox any more.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht mehr in Shepherds Inbox."
          }
        }
      }
    },
    "%@ is not one of this pull request's changed files": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist keine der von diesem Pull Request geänderten Dateien"
          }
        }
      }
    },
    "%@ is still a draft — GitHub refuses the merge until it is marked ready for review.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist noch ein Draft — GitHub lehnt den Merge ab, bis er als bereit zum Review markiert ist."
          }
        }
      }
    },
    "%@ · %@ · %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · %@"
          }
        }
      }
    },
    "%@ · %lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld"
          }
        }
      }
    },
    "%@ · green, approved, agent-authored. Shepherd queued a %@ merge.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · grün, approved, von einem Agenten. Shepherd hat einen %@-Merge eingereiht."
          }
        }
      }
    },
    "%@ · nothing is pushed; open the delegation to review the diff.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Es wird nichts gepusht; öffne die Delegation, um den Diff zu prüfen."
          }
        }
      }
    },
    "%@ — %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — %@."
          }
        }
      }
    },
    "%@ → %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@"
          }
        }
      }
    },
    "%@#%lld got new commits after you wrote your review, so your inline comments would land on the wrong lines. Your draft is kept — open the pull request again to check it against the new commit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@#%lld hat neue Commits bekommen, nachdem du dein Review geschrieben hast — deine Inline-Kommentare würden auf den falschen Zeilen landen. Dein Draft bleibt erhalten; öffne den Pull Request erneut und prüfe ihn gegen den neuen Commit."
          }
        }
      }
    },
    "%@#%lld is not an issue Shepherd can open.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@#%lld ist kein Issue, das Shepherd öffnen kann."
          }
        }
      }
    },
    "%@'s first push is green in %@ of its pull requests to %@, and in %@ across %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erste Push von %@ ist in %@ seiner Pull Requests an %@ grün und in %@ über %@."
