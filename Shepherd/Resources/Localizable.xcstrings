    "Full review": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollständige Review"
          }
        }
      }
    },
    "GUARDRAILS": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LEITLINIEN"
          }
        }
      }
