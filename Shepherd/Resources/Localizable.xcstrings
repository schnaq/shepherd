          "stringUnit": {
            "state": "translated",
            "value": "Pull Request öffnen"
          }
        }
      }
    },
    "Open Settings → Delegation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen → Delegation öffnen"
          }
