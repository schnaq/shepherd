            "value": "Unbenannte Antwort"
          }
        }
      }
    },
    "Unresolve": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auflösung aufheben"
          }
        }
      }
    },
    "Updates are downloaded from GitHub Releases and are only installed after you confirm — never in the background, so an unsent review draft can never be interrupted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates werden von GitHub Releases geladen und erst nach deiner Bestätigung installiert — nie im Hintergrund, damit ein nicht gesendeter Review-Draft nie unterbrochen wird."
          }
        }
      }
    },
    "Upload settings": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen hochladen"
          }
        }
      }
    },
    "Uploaded. The bucket now holds your settings and %lld secrets, encrypted.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Hochgeladen. Der Bucket enthält jetzt deine Einstellungen und %lld Secret, verschlüsselt."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Hochgeladen. Der Bucket enthält jetzt deine Einstellungen und %lld Secrets, verschlüsselt."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Uploaded. The bucket now holds your settings and %lld secret, encrypted."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Uploaded. The bucket now holds your settings and %lld secrets, encrypted."
                }
              }
            }
          }
        }
      }
    },
    "Use a passphrase of at least %lld characters — it is the only thing protecting your tokens in the bucket.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm eine Passphrase mit mindestens %lld Zeichen — sie ist das Einzige, was deine Tokens im Bucket schützt."
          }
        }
      }
    },
    "Used as the summary of a new review on a matching repository. An existing draft — a comment, a summary, a verdict — is never overwritten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird als Zusammenfassung eines neuen Reviews auf einem passenden Repository genutzt. Ein bestehender Draft — ein Kommentar, eine Zusammenfassung, eine Bewertung — wird nie überschrieben."
          }
        }
      }
    },
    "Verdict": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewertung"
          }
        }
      }
    },
    "Viewed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesehen"
          }
        }
      }
    },
    "Virtual-hosted style": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtual-Hosted-Stil"
          }
        }
      }
    },
    "WHAT AI NEVER DOES": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WAS KI NIE TUT"
          }
        }
      }
    },
    "WHAT DELEGATION NEVER DOES": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WAS DIE DELEGATION NIE TUT"
          }
        }
      }
    },
    "WHAT IT READ · %lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GELESEN · %lld"
          }
        }
      }
    },
    "WHAT SHEPHERD MERGED": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WAS SHEPHERD GEMERGT HAT"
          }
        }
      }
    },
    "WHAT WEBHOOKS NEVER SEND": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WAS WEBHOOKS NIE SENDEN"
          }
        }
      }
    },
    "WHY IS CI RED?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WARUM IST CI ROT?"
          }
        }
      }
    },
    "WHY THIS RISK": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WARUM DIESES RISIKO"
          }
        }
      }
    },
    "WHY THIS VERDICT": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WARUM DIESE EINORDNUNG"
          }
        }
      }
    },
    "WILL BE QUEUED (%lld)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WIRD EINGEREIHT (%lld)"
          }
        }
      }
    },
    "Waiting for you to approve…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte auf deine Bestätigung…"
          }
        }
      }
    },
    "Weekdays only": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur an Wochentagen"
          }
        }
      }
    },
    "What these lines change": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was diese Zeilen ändern"
          }
        }
      }
    },
    "When the model looks something up, it can only read — the checks, a log, a file. It cannot comment, approve, merge or start an agent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das Modell etwas nachschaut, kann es nur lesen — die Checks, ein Log, eine Datei. Es kann nicht kommentieren, nichts approven, nichts mergen und keinen Agenten starten."
          }
        }
      }
    },
    "Why Shepherd flagged this risk": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum Shepherd dieses Risiko meldet"
          }
        }
      }
    },
    "Why this pull request was classified this way": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum dieser Pull Request so eingeordnet wurde"
          }
        }
      }
    },
    "Why?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum?"
          }
        }
      }
    },
    "With a secret set, every request carries X-Shepherd-Signature: sha256=<HMAC-SHA256 of the body>. That is the same shape as GitHub's X-Hub-Signature-256, so a verification step built for GitHub works unchanged. The secret is stored in your Keychain, next to the GitHub token.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist ein Secret gesetzt, trägt jede Anfrage X-Shepherd-Signature: sha256=<HMAC-SHA256 des Bodys>. Das ist dieselbe Form wie GitHubs X-Hub-Signature-256, ein für GitHub gebauter Prüfschritt funktioniert also unverändert. Das Secret liegt in deinem Schlüsselbund, neben dem GitHub-Token."
          }
        }
      }
    },
    "Work through the %lld pull requests waiting for your review, one at a time (r f)": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Arbeite den %lld Pull Request ab, der auf dein Review wartet (r f)"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Arbeite die %lld Pull Requests ab, die auf dein Review warten — einen nach dem anderen (r f)"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Work through the %lld pull request waiting for your review (r f)"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Work through the %lld pull requests waiting for your review, one at a time (r f)"
                }
              }
            }
          }
        }
      }
    },
    "Worked out from the changed files without a model, so there is no kind and no sentence — just what the paths and the diff say.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Modell aus den geänderten Dateien ermittelt — daher gibt es keine Art und keinen Satz, nur das, was Pfade und Diff sagen."
          }
        }
      }
    },
    "Wrap long lines": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lange Zeilen umbrechen"
          }
        }
      }
    },
    "Write a summary first — GitHub rejects a “request changes” or “comment” review without one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe zuerst eine Zusammenfassung — GitHub lehnt ein „request changes“- oder „comment“-Review ohne eine ab."
          }
        }
      }
    },
    "Wrong passphrase or corrupted data. Nothing was applied.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falsche Passphrase oder beschädigte Daten. Es wurde nichts übernommen."
          }
        }
      }
    },
    "YOUR EXTENSIONS": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DEINE ERWEITERUNGEN"
          }
        }
      }
    },
    "You are running inside a detached git worktree that Shepherd created for pull request #%lld of %@ — branch %@, checked out at commit %@.\n\nGround rules:\n- Do not push, do not create or switch branches, and do not open a pull request. The reviewer reads your diff and pushes it themselves.\n- Keep the change as small as it can be. Do not reformat, rename or refactor anything the task does not ask for.\n- Prefer the project's existing tests and tooling over adding new ones.\n- If the task is unclear or you would have to guess at intent, say so in your final message instead of guessing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du läufst in einem separaten Git-Worktree, den Shepherd für Pull Request #%lld von %@ erstellt hat — Branch %@, ausgecheckt auf Commit %@.\n\nGrundregeln:\n- Nicht pushen, keine Branches erstellen oder wechseln und keinen Pull Request öffnen. Der Reviewer liest deinen Diff und pusht ihn selbst.\n- Halte die Änderung so klein wie möglich. Formatiere, benenne und refaktoriere nichts um, was die Aufgabe nicht verlangt.\n- Nutze bevorzugt die bestehenden Tests und Werkzeuge des Projekts, statt neue hinzuzufügen.\n- Ist die Aufgabe unklar oder müsstest du die Absicht erraten, sage das in deiner Abschlussnachricht, statt zu raten."
          }
        }
      }
    },
    "You have a local draft whose inline comments were written on an older commit. The approval keeps that draft, so it will be parked as a conflict rather than sent — open the pull request to check the comments against the new commit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast einen lokalen Draft, dessen Inline-Kommentare auf einem älteren Commit geschrieben wurden. Das Approval behält diesen Draft, er wird also als Konflikt geparkt statt gesendet — öffne den Pull Request und prüfe die Kommentare gegen den neuen Commit."
          }
        }
      }
    },
    "You have no open pull requests.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast keine offenen Pull Requests."
          }
        }
      }
    },
    "Your settings and your secrets are encrypted on this Mac with a passphrase you choose, then stored as one object in a bucket you own. The bucket operator — and anyone who can read the bucket — sees ciphertext only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Einstellungen und deine Secrets werden auf diesem Mac mit einer Passphrase verschlüsselt, die du wählst, und dann als ein Objekt in einem Bucket abgelegt, der dir gehört. Der Bucket-Betreiber — und jeder, der den Bucket lesen kann — sieht nur Chiffrat."
          }
        }
      }
    },
    "`git %@` failed with status %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`git %@` ist mit Status %lld fehlgeschlagen."
          }
        }
      }
    },
    "`git %@` failed: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`git %@` ist fehlgeschlagen: %@"
          }
        }
      }
    },
    "a recognised agent opened it": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ein erkannter Agent ihn geöffnet hat"
          }
        }
      }
    },
    "a reviewer requests changes": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ein Reviewer Änderungen anfordert"
          }
        }
      }
    },
    "approve": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "approve"
          }
        }
      }
    },
    "approve + merge": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "approve + merge"
          }
        }
      }
    },
    "approved": {
      "localizations": {
