        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehl eingeben…"
          }
        }
      }
    },
    "Type a name": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen eingeben"
          }
        }
