    "Generated": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Generiert"
          }
        }
      }
    },
    "Generated or vendored file": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Generierte oder mitgelieferte Datei"
          }
        }
      }
    },
    "Get Pull Requests Needing Review": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull Requests abrufen, die ein Review brauchen"
          }
        }
      }
    },
    "Get your API key at console.konduit.eu": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deinen API-Schlüssel gibt es auf console.konduit.eu"
          }
        }
      }
    },
    "GitHub did not send a database id for this thread, so Shepherd cannot reply to it here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat für diesen Thread keine Datenbank-ID mitgeschickt, deshalb kann Shepherd hier nicht darauf antworten."
          }
        }
      }
    },
    "GitHub did not send a diff for this file — it is binary, or the patch was too large.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat für diese Datei keinen Diff mitgeschickt — sie ist binär, oder der Patch war zu groß."
          }
        }
      }
    },
    "GitHub does not accept an approve or request changes on your own pull request (%@).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub akzeptiert kein Approve oder Request changes auf deinem eigenen Pull Request (%@)."
          }
        }
      }
    },
    "GitHub has not finished computing mergeability. The merge may be refused and will then be retried.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ist mit der Mergebarkeit noch nicht fertig. Der Merge kann abgelehnt und wird dann erneut versucht."
          }
        }
      }
    },
    "GitHub has not finished computing mergeability. The merge may be refused.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ist mit der Mergebarkeit noch nicht fertig. Der Merge kann abgelehnt werden."
          }
        }
      }
    },
    "GitHub refused these writes, or Shepherd could not make them at all. Nothing about them changes by itself: retry one once you have fixed what stopped it, or discard it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat diese Änderungen abgelehnt, oder Shepherd konnte sie gar nicht erst senden. Von allein ändert sich daran nichts: Sende eine erneut, sobald du behoben hast, was sie verhindert hat, oder verwirf sie."
          }
        }
      }
    },
    "GitHub refuses an approval on a pull request you opened yourself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub lehnt ein Approval auf einem Pull Request ab, den du selbst geöffnet hast."
          }
        }
      }
    },
    "GitHub reported no changed files for this pull request.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat für diesen Pull Request keine geänderten Dateien gemeldet."
          }
        }
      }
    },
    "GitHub reports %lld changed files, but sent none of them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub meldet %lld geänderte Dateien, hat aber keine davon geschickt."
          }
        }
      }
    },
    "GitHub reports conflicts with %@. Resolve them first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub meldet Konflikte mit %@. Löse sie zuerst auf."
          }
        }
      }
    },
    "GitHub reports conflicts with the base branch. Resolve them first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub meldet Konflikte mit dem Base-Branch. Löse sie zuerst auf."
          }
        }
      }
    },
    "GitHub reports it as mergeable": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ihn als mergebar meldet"
          }
        }
      }
    },
    "GitHub requires a summary for this verdict — only an approval may be submitted without one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
